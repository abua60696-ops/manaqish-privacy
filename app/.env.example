# انسخ هذا الملف باسم .env وضع فيه مفاتيح مشروع Firebase الخاص بك
# احصل عليها من: Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# رقم واتساب المطعم (بصيغة دولية بدون + أو أصفار زائدة)
VITE_WHATSAPP_NUMBER=963947420675
